# ─── Application ───
APP_NAME=Enterprise FastAPI
APP_VERSION=1.0.0
DEBUG=false

# ─── Database ───
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/enterprise_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ─── JWT Authentication ───
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── File storage ───
# Base directory for everything the app writes to disk (log files today). Points
# at the mounted storage volume. A subdir keeps this app's files separate from
# other apps sharing the same mount. Must be writable by the application user.
UPLOAD_DIR=D:\TestDocs-Emcatalyst-Migration-App\core-service

# ─── Logging ───
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/application.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# ─── Redis ───
REDIS_URL=redis://localhost:6379/0

# ─── Celery ───
CELERY_BROKER_URL=redis://localhost:6379/1

# ─── OpenTelemetry ───
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=enterprise-api

# ─── Azure AD / Microsoft SSO ───
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_REDIRECT_URI=http://localhost:3000/oauth/v2/callback

# ─── CORS ───
CORS_ORIGINS=["http://localhost:3000"]

# ─── Auth Cookies (refresh token) ───
# COOKIE_SECURE must be true in production (HTTPS). Keep false for local http dev.
# For cross-site (API on a different domain than the SPA) use COOKIE_SAMESITE=none + COOKIE_SECURE=true.
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ─── Employee Ad Service ───
EMPLOYEE_AD_BASE_URL=https://ad-prod-darwinsvc-prod.apps.emart.oneemcure.local/rest-doc/adintegratorservices/rest/v1 

# ─── Published Darwin AD service ───
# Shared Fernet key for the published /validatecredentials endpoint. Consuming
# apps encrypt username + password with this key; this service decrypts them
# before the LDAP bind. Hand the same value to the consuming apps. Leave empty
# to accept plaintext (drop-in). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DARWIN_VALIDATE_ENCRYPTION_KEY=

# ─── LDAP / Active Directory ───
# LDAP server configurations are stored in the database and managed from the
# "LDAP Servers" page (Management). No environment variables are required.

# ─── Darwinbox Master API (employee sync) ───
DARWINBOX_BASE_URL=https://emcure.darwinbox.in/masterapi/employee
DARWINBOX_USERNAME=
DARWINBOX_PASSWORD=
DARWINBOX_API_KEY=
DARWINBOX_DATASET_KEY=
# Inactive dataset (same URL, different credentials/keys)
DARWINBOX_INACTIVE_USERNAME=
DARWINBOX_INACTIVE_PASSWORD=
DARWINBOX_INACTIVE_API_KEY=
DARWINBOX_INACTIVE_DATASET_KEY=

# ─── E-Signer Service ───
ESIGNER_BASE_URL=
ESIGNER_USERNAME=
ESIGNER_PASSWORD=
ESIGNER_EMAIL=
ESIGNER_APP_NAME=
ESIGNER_SECRET_KEY=
ESIGNER_TEMP_PASSWORD=
# Optional shared secret for the published E-Signer endpoints (X-API-Key header).
# Leave empty for open/drop-in access.
ESIGNER_PUBLISHED_API_KEY=
